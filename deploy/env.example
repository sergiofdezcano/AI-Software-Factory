# /etc/ai-factory/env  (permisos 600, propiedad de factory)

# GitHub: token fine-grained de la fábrica. Repos: las apps y AI-Software-Factory.
# Permisos: Contents, Issues y Pull requests (read/write); Metadata (read).
GH_TOKEN=

# Claude: token de larga duración de tu suscripción (`claude setup-token` en cualquier PC).
CLAUDE_CODE_OAUTH_TOKEN=

# Avisos por Telegram: token del bot de Hermes y tu chat id.
FACTORY_TELEGRAM_BOT_TOKEN=
FACTORY_TELEGRAM_CHAT_ID=

# Dónde están los clones de las apps en el servidor.
FACTORY_APPS_DIR=/srv/apps

# Opcional
# FACTORY_MODEL_BIG=opus
# FACTORY_MODEL_REVIEW=sonnet
# FACTORY_MODEL_CODEX=
# FACTORY_GIT_EMAIL=ai-factory@users.noreply.github.com
